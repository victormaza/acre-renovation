{
  "id": "page",
  "label": "Page simple",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "Identifiant d'URL",
          "placeholder": "entreprise — donne l'adresse acre-renovation.fr/entreprise"
        }
      },
      "eyebrow": {
        "type": "Text",
        "config": {
          "label": "Surtitre",
          "placeholder": "L'entreprise — court, affiché au-dessus du titre"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Titre",
          "placeholder": "Une entreprise générale de rénovation en Gironde"
        }
      },
      "subtitle": {
        "type": "Text",
        "config": {
          "label": "Sous-titre",
          "placeholder": "Facultatif — prolonge le titre en une ligne"
        }
      },
      "lead": {
        "type": "StructuredText",
        "config": {
          "label": "Chapô",
          "placeholder": "Le paragraphe d'ouverture, en plus gros que le texte",
          "single": "paragraph"
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "Texte",
          "placeholder": "Le contenu de la page : paragraphes, sous-titres, listes",
          "multi": "paragraph,heading2,heading3,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Sections ajoutées sous le texte",
        "config": {
          "choices": {
            "methode": {
              "type": "SharedSlice"
            },
            "expertises": {
              "type": "SharedSlice"
            },
            "realisations": {
              "type": "SharedSlice"
            },
            "guides": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "reassurance": {
              "type": "SharedSlice"
            },
            "avis": {
              "type": "SharedSlice"
            },
            "zone_intervention": {
              "type": "SharedSlice"
            },
            "cta_final": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Titre de la page",
          "placeholder": "Affiché dans l'onglet du navigateur et sur Google"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Description",
          "placeholder": "Résumé affiché sous le titre dans les résultats de recherche"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Image de partage",
          "constraint": {
            "width": 1200,
            "height": 630
          },
          "thumbnails": []
        }
      }
    }
  },
  "status": true,
  "format": "page"
}
