---
// Visionneuse d'image, posée par la grille de réalisations.
//
// Il n'y a pas de page par chantier : une réalisation, c'est une photo et
// deux lignes de légende, pas un article. La carte ouvre donc l'image en
// grand plutôt que de mener à une page à écrire.
//
// Le déclencheur reste un vrai lien vers le fichier image (voir
// `RealisationGrid`) : sans JavaScript, le clic ouvre la photo, et jamais un
// bouton mort. Le script se contente d'intercepter le clic pour l'afficher
// ici, comme le tunnel de devis replie un formulaire qui marche déjà.
//
// Le `<dialog>` natif apporte l'essentiel gratuitement : fermeture à Échap,
// piège à focus, restitution du focus au retour, et inertie du reste de la
// page. Un seul exemplaire suffit par page, il sert toutes les grilles.
---

<dialog class="lightbox" aria-label="Photo de chantier">
	<button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Photo précédente">
		<svg viewBox="0 0 24 24" aria-hidden="true"
			><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="2"></path></svg
		>
	</button>

	<figure class="lightbox__figure">
		<img class="lightbox__image" sizes="90vw" alt="" />
		<figcaption class="lightbox__caption">
			<strong class="lightbox__title"></strong>
			<span class="lightbox__meta"></span>
		</figcaption>
	</figure>

	<button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Photo suivante">
		<svg viewBox="0 0 24 24" aria-hidden="true"
			><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2"></path></svg
		>
	</button>

	<button class="lightbox__close" type="button" aria-label="Fermer">
		<svg viewBox="0 0 24 24" aria-hidden="true"
			><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="2"></path></svg
		>
	</button>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('.lightbox');

	if (dialog) {
		const image = dialog.querySelector<HTMLImageElement>('.lightbox__image')!;
		const title = dialog.querySelector<HTMLElement>('.lightbox__title')!;
		const meta = dialog.querySelector<HTMLElement>('.lightbox__meta')!;
		const previous = dialog.querySelector<HTMLButtonElement>('.lightbox__nav--prev')!;
		const next = dialog.querySelector<HTMLButtonElement>('.lightbox__nav--next')!;

		// La galerie courante : les déclencheurs de la grille cliquée, dans
		// l'ordre du document. Recalculée à chaque ouverture, une page pouvant
		// porter plusieurs grilles.
		let gallery: HTMLAnchorElement[] = [];
		let index = 0;

		// Le reste de la page est rendu inerte par `showModal()`, mais pas
		// immobile : la molette continue de le faire défiler derrière.
		const lockPage = () => {
			document.documentElement.classList.toggle('has-lightbox', dialog.open);
		};

		const show = (position: number) => {
			index = (position + gallery.length) % gallery.length;
			const trigger = gallery[index];

			image.src = trigger.href;
			image.srcset = trigger.dataset.lightboxSrcset ?? '';
			image.alt = trigger.dataset.lightboxAlt ?? '';
			title.textContent = trigger.dataset.lightboxTitle ?? '';
			meta.textContent = trigger.dataset.lightboxMeta ?? '';

			// Une seule photo : les flèches n'ont nulle part où aller.
			previous.hidden = next.hidden = gallery.length < 2;
		};

		// Délégation : les cartes ne sont pas les seules à pouvoir ouvrir la
		// visionneuse, et une grille peut être rendue plusieurs fois.
		document.addEventListener('click', (event) => {
			const target = event.target as Element | null;
			const trigger = target?.closest<HTMLAnchorElement>('a[data-lightbox]');
			if (!trigger) return;

			// Ouvrir dans un onglet, enregistrer l'image : on ne s'en mêle pas.
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

			event.preventDefault();

			const scope = trigger.closest('[data-lightbox-gallery]') ?? document;
			gallery = [...scope.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
			show(gallery.indexOf(trigger));

			dialog.showModal();
			lockPage();
		});

		previous.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));
		dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());

		// Cliquer à côté de la photo ferme. On ne peut pas se contenter de
		// comparer la cible au `<dialog>` : la figure occupe toute la colonne
		// centrale de la grille, donc la moitié du vide en fait déjà partie.
		// C'est ce qui se voit — la photo, sa légende, les boutons — qui ne
		// ferme pas ; tout le reste est du fond.
		dialog.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (!target.closest('.lightbox__image, .lightbox__caption, button')) dialog.close();
		});

		dialog.addEventListener('keydown', (event) => {
			if (gallery.length < 2) return;
			if (event.key === 'ArrowLeft') show(index - 1);
			if (event.key === 'ArrowRight') show(index + 1);
		});

		// Échap et le clic sur le fond ferment sans passer par nos boutons : on
		// ne nettoie donc pas au clic mais sur l'état réel du `<dialog>`.
		//
		// Les deux événements font le même travail à dessein : `close` est
		// universel mais Chrome 152 ne l'a pas émis ici, `toggle` est fiable
		// mais récent. La bascule étant calquée sur `dialog.open`, la recevoir
		// deux fois ne coûte rien.
		dialog.addEventListener('close', lockPage);
		dialog.addEventListener('toggle', lockPage);
	}
</script>

<style>
	/* Même piège que dans le tunnel de devis : les flèches portent un
	   `display`, qui l'emporte sur la règle par défaut du navigateur. Sans ça,
	   une galerie d'une seule photo garderait ses flèches à l'écran. */
	[hidden] {
		display: none !important;
	}

	:global(html.has-lightbox) {
		overflow: hidden;
	}

	.lightbox {
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		color: var(--on-ink);
		overflow: hidden;
	}

	.lightbox[open] {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: clamp(4px, 2vw, 20px);
		padding: clamp(16px, 4vw, 40px);
	}

	.lightbox::backdrop {
		background: rgb(21 18 14 / 0.88);
	}

	.lightbox__figure {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin: 0;
		min-height: 0;
	}

	.lightbox__image {
		max-width: 100%;
		/* La légende et les marges verticales prises sur la hauteur d'écran. */
		max-height: calc(100dvh - 200px);
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: var(--radius-md);
		background: var(--bg-photo);
	}

	.lightbox__caption {
		text-align: center;
		max-width: 60ch;
	}

	.lightbox__title {
		display: block;
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 18px;
		line-height: 1.3;
		color: var(--on-ink-title);
	}

	.lightbox__meta {
		font-size: 14px;
		color: var(--on-ink-text);
	}

	.lightbox__nav,
	.lightbox__close {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgb(251 250 247 / 0.12);
		color: var(--on-ink);
		cursor: pointer;
	}

	.lightbox__nav:hover,
	.lightbox__close:hover {
		background: rgb(251 250 247 / 0.22);
	}

	.lightbox__nav svg,
	.lightbox__close svg {
		width: 22px;
		height: 22px;
	}

	.lightbox__close {
		position: absolute;
		top: clamp(12px, 3vw, 24px);
		right: clamp(12px, 3vw, 24px);
	}

	/* Sur mobile, les flèches passent sous la photo plutôt que de la rogner. */
	@media (max-width: 640px) {
		.lightbox[open] {
			grid-template-columns: 1fr 1fr;
			grid-template-areas: 'figure figure' 'prev next';
			align-content: center;
			gap: 20px;
		}

		.lightbox__figure {
			grid-area: figure;
		}

		.lightbox__nav--prev {
			grid-area: prev;
			justify-self: end;
		}

		.lightbox__nav--next {
			grid-area: next;
			justify-self: start;
		}

		.lightbox__image {
			max-height: calc(100dvh - 300px);
		}
	}
</style>
