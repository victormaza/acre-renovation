---
interface Props {
	eyebrow: string;
	title: string;
	text: string;
	cities: string[];
}

const { eyebrow, title, text, cities } = Astro.props;
---

<section class="zone">
	<div class="container zone__inner">
		<div class="zone__body">
			<p class="eyebrow">{eyebrow}</p>
			<h2 class="zone__title">{title}</h2>
			<p class="zone__text">{text}</p>
			<ul class="chips">
				{cities.map((city) => <li class="chip">{city}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.zone {
		margin-top: var(--section-space);
		background: var(--bg-alt);
		border-top: 1px solid var(--line-alt);
		border-bottom: 1px solid var(--line-alt);
	}

	.zone__inner {
		padding-block: 84px;
	}

	.zone__body {
		max-width: 720px;
	}

	.eyebrow {
		margin: 0 0 18px;
	}

	.zone__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: clamp(28px, 3.6vw, 42px);
		line-height: 1.06;
		letter-spacing: -0.015em;
		margin: 0 0 20px;
		text-wrap: balance;
	}

	.zone__text {
		font-size: 17px;
		line-height: 1.62;
		color: var(--text);
		margin: 0 0 30px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.chip {
		font-size: 14px;
		font-weight: 500;
		background: var(--bg);
		border: 1px solid var(--line-chip);
		padding: 9px 15px;
		border-radius: var(--radius-sm);
	}
</style>
