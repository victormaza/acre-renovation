---
interface Props {
	eyebrow: string;
	title: string;
	text: string;
	cities: string[];
}

const { eyebrow, title, text, cities } = Astro.props;
---

<section class="zone">
	<div class="container zone__inner">
		<div>
			<p class="eyebrow">{eyebrow}</p>
			<h2 class="zone__title">{title}</h2>
			<p class="zone__text">{text}</p>
			<ul class="chips">
				{cities.map((city) => <li class="chip">{city}</li>)}
			</ul>
		</div>

		<!-- Schéma décoratif : les positions sont dessinées à la main, il ne
		     suit pas la liste de villes ci-dessus. Doublé par les chips, donc
		     masqué aux lecteurs d'écran. -->
		<div class="zone__map">
			<svg viewBox="0 0 500 400" aria-hidden="true" focusable="false">
				<defs>
					<radialGradient id="zone-bg" cx="46%" cy="52%" r="55%">
						<stop offset="0%" stop-color="#f6f2e9"></stop>
						<stop offset="100%" stop-color="#fbfaf7"></stop>
					</radialGradient>
				</defs>
				<rect width="500" height="400" fill="url(#zone-bg)"></rect>
				<path
					d="M120 30 C 155 90, 130 150, 150 200 C 168 245, 140 300, 165 370"
					fill="none"
					stroke="#d9cfba"
					stroke-width="2"
					stroke-dasharray="2 6"
					stroke-linecap="round"></path>
				<text x="112" y="24" class="svg-label" text-anchor="middle">Océan</text>
				<circle cx="232" cy="208" r="118" fill="none" stroke="#e0d6c3" stroke-width="1.5"></circle>
				<circle cx="232" cy="208" r="70" fill="none" stroke="#eadfcb" stroke-width="1.5"></circle>
				<text x="352" y="150" class="svg-label">rayon 100 km</text>

				<circle cx="232" cy="208" r="7" fill="#e47b02"></circle>
				<circle
					cx="232"
					cy="208"
					r="13"
					fill="none"
					stroke="#e47b02"
					stroke-opacity="0.35"
					stroke-width="2"></circle>
				<text x="248" y="205" class="svg-city">Bordeaux</text>

				<circle cx="196" cy="190" r="4" fill="#8a8070"></circle>
				<text x="150" y="182" class="svg-town" text-anchor="end">Mérignac</text>
				<circle cx="214" cy="244" r="4" fill="#8a8070"></circle>
				<text x="222" y="262" class="svg-town">Pessac</text>
				<circle cx="126" cy="230" r="4" fill="#8a8070"></circle>
				<text x="118" y="248" class="svg-town" text-anchor="end">Andernos</text>
				<circle cx="104" cy="272" r="4" fill="#8a8070"></circle>
				<text x="96" y="290" class="svg-town" text-anchor="end">Cap Ferret</text>
				<circle cx="150" cy="300" r="4" fill="#8a8070"></circle>
				<text x="158" y="316" class="svg-town">Arcachon</text>
			</svg>
		</div>
	</div>
</section>

<style>
	.zone {
		margin-top: var(--section-space);
		background: var(--bg-alt);
		border-top: 1px solid var(--line-alt);
		border-bottom: 1px solid var(--line-alt);
	}

	.zone__inner {
		padding-block: 84px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 56px;
		align-items: center;
	}

	.eyebrow {
		margin: 0 0 18px;
	}

	.zone__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: clamp(28px, 3.6vw, 42px);
		line-height: 1.06;
		letter-spacing: -0.015em;
		margin: 0 0 20px;
		text-wrap: balance;
	}

	.zone__text {
		font-size: 17px;
		line-height: 1.62;
		color: var(--text);
		margin: 0 0 30px;
		max-width: 460px;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.chip {
		font-size: 14px;
		font-weight: 500;
		background: var(--bg);
		border: 1px solid var(--line-chip);
		padding: 9px 15px;
		border-radius: var(--radius-sm);
	}

	.zone__map {
		position: relative;
		aspect-ratio: 5 / 4;
		background: var(--bg);
		border: 1px solid #e6ddcc;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.zone__map svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.svg-label {
		font-family: var(--font-body);
		font-size: 11px;
		fill: var(--muted-softer);
	}

	.svg-city {
		font-family: var(--font-title);
		font-size: 15px;
		font-weight: 600;
		fill: var(--ink);
	}

	.svg-town {
		font-family: var(--font-body);
		font-size: 12px;
		fill: var(--text);
	}
</style>
