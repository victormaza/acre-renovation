---
// Grille de cartes chantier : photo, badge ville, titre, précision.
//
// Extraite de la section d'accueil parce que la page /realisations affiche
// exactement les mêmes cartes — seul l'en-tête et le nombre d'éléments
// changent. Le jour où la carte évolue, il n'y a qu'un fichier à reprendre.
import Photo from './Photo.astro';
import type { RealisationCard } from '../types';

interface Props {
	items: RealisationCard[];
}

const { items } = Astro.props;
---

<ul class="grid">
	{
		items.map((item) => (
			<li>
				<a class="realisation" href={item.href}>
					<div class="realisation__media">
						<Photo {...item.image} ratio="4 / 3" radius="var(--radius-md)" />
						<span class="realisation__city">{item.city}</span>
					</div>
					<h3 class="realisation__title">{item.title}</h3>
					<p class="realisation__meta">{item.meta}</p>
				</a>
			</li>
		))
	}
</ul>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.realisation {
		display: block;
	}

	.realisation__media {
		position: relative;
		margin-bottom: 16px;
	}

	.realisation__city {
		position: absolute;
		top: 14px;
		left: 14px;
		background: rgb(251 250 247 / 0.94);
		color: var(--ink);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 6px 11px;
		border-radius: 3px;
	}

	.realisation__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 18px;
		line-height: 1.2;
		margin: 0 0 4px;
	}

	.realisation__meta {
		font-size: 14px;
		color: var(--muted);
		margin: 0;
	}
</style>
