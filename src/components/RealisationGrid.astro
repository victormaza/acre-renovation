---
// Grille de cartes chantier : photo, badge ville, titre, précision.
//
// Extraite de la section d'accueil parce que la page /realisations affiche
// exactement les mêmes cartes — seul l'en-tête et le nombre d'éléments
// changent. Le jour où la carte évolue, il n'y a qu'un fichier à reprendre.
//
// La carte n'ouvre pas de page dédiée : une réalisation, c'est une photo et
// deux lignes de légende. Le clic agrandit donc la photo dans la visionneuse
// (voir `Lightbox.astro`). Le lien pointe malgré tout vers le fichier image
// en pleine taille : sans JavaScript, il ouvre la photo au lieu de ne rien
// faire, et « ouvrir dans un nouvel onglet » garde du sens.
import { asImageWidthSrcSet, isFilled } from '@prismicio/client';
import Lightbox from './Lightbox.astro';
import Photo from './Photo.astro';
import type { RealisationCard } from '../types';

interface Props {
	items: RealisationCard[];
}

const { items } = Astro.props;

// Largeurs de visionneuse, plus généreuses que celles de la carte : c'est le
// même CDN qui sert les deux, seuls les paramètres imgix changent.
const cards = items.map((item) => {
	const field = item.image.field;
	const full =
		field && isFilled.image(field)
			? asImageWidthSrcSet(field, {
					widths: [960, 1280, 1600, 2000],
					auto: ['format', 'compress'],
				})
			: null;

	return {
		...item,
		// Une carte sans photo n'a rien à agrandir : elle reste inerte plutôt
		// que d'ouvrir une visionneuse vide.
		href: full?.src ?? item.image.src,
		srcset: full?.srcset,
		alt: field?.alt ?? item.image.alt ?? '',
	};
});
---

<ul class="grid" data-lightbox-gallery>
	{
		cards.map((card) => {
			const Tag = card.href ? 'a' : 'div';

			return (
				<li>
					<Tag
						class="realisation"
						href={card.href}
						data-lightbox={card.href ? true : undefined}
						data-lightbox-srcset={card.srcset}
						data-lightbox-alt={card.alt}
						data-lightbox-title={card.title}
						data-lightbox-meta={[card.city, card.meta].filter(Boolean).join(' — ')}
						aria-haspopup={card.href ? 'dialog' : undefined}
					>
						<div class="realisation__media">
							<Photo {...card.image} ratio="4 / 3" radius="var(--radius-md)" />
							<span class="realisation__city">{card.city}</span>
						</div>
						<h3 class="realisation__title">{card.title}</h3>
						<p class="realisation__meta">{card.meta}</p>
					</Tag>
				</li>
			);
		})
	}
</ul>

<Lightbox />

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.realisation {
		display: block;
	}

	a.realisation {
		cursor: zoom-in;
	}

	.realisation__media {
		position: relative;
		margin-bottom: 16px;
	}

	.realisation__city {
		position: absolute;
		top: 14px;
		left: 14px;
		background: rgb(251 250 247 / 0.94);
		color: var(--ink);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 6px 11px;
		border-radius: 3px;
	}

	.realisation__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 18px;
		line-height: 1.2;
		margin: 0 0 4px;
	}

	.realisation__meta {
		font-size: 14px;
		color: var(--muted);
		margin: 0;
	}
</style>
