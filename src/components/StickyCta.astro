---
// Barre collante mobile. Le prototype pilotait son affichage en JS via
// matchMedia ; une media query suffit et évite le flash au chargement.
interface Props {
	label: string;
	href: string;
}

const { label, href } = Astro.props;
---

<div class="sticky">
	<a class="btn btn--dark sticky__cta" href={href}>
		<span class="btn-dot"></span>{label}
	</a>
</div>

<style>
	.sticky {
		display: none;
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 60;
		padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
		background: rgb(251 250 247 / 0.95);
		backdrop-filter: blur(8px);
		border-top: 1px solid var(--line);
	}

	.sticky__cta {
		width: 100%;
		justify-content: center;
		padding: 15px;
	}

	@media (max-width: 860px) {
		.sticky {
			display: block;
		}
	}
</style>
