---
interface Props {
	id?: string;
	title: string;
	text: string;
	cta: { label: string; href: string };
	note: string;
}

const { id, title, text, cta, note } = Astro.props;
---

<section class="container cta" id={id}>
	<div class="cta__panel">
		<div>
			<h2 class="cta__title">{title}</h2>
			<p class="cta__text">{text}</p>
		</div>
		<div class="cta__actions">
			<a class="btn btn--accent" href={cta.href}>{cta.label} <span>→</span></a>
			<p class="cta__note">{note}</p>
		</div>
	</div>
</section>

<style>
	.cta {
		margin-top: var(--section-space);
	}

	.cta__panel {
		background: var(--ink);
		border-radius: var(--radius-lg);
		padding: clamp(48px, 6vw, 84px) clamp(28px, 5vw, 64px);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 40px;
		align-items: center;
	}

	.cta__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: clamp(30px, 3.8vw, 48px);
		line-height: 1.04;
		letter-spacing: -0.02em;
		margin: 0 0 18px;
		color: var(--on-ink-title);
		text-wrap: balance;
	}

	.cta__text {
		font-size: 18px;
		line-height: 1.6;
		color: var(--on-ink-text);
		margin: 0;
		max-width: 460px;
	}

	.cta__actions {
		display: flex;
		flex-direction: column;
		gap: 14px;
		align-items: flex-start;
	}

	.cta__note {
		font-size: 14px;
		color: var(--on-ink-muted);
		margin: 0;
	}
</style>
