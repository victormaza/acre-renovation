---
// En-tête de page : surtitre, <h1>, sous-titre et chapô, tous facultatifs
// sauf le titre. Sert les pages de listing comme les pages de texte.
// Pendant de SectionHead, qui porte le <h2> d'une section parmi d'autres.
// L'écart avec l'en-tête du site est déjà porté par le fil d'ariane.
//
// Sous-titre et chapô se distinguent par la fonte autant que par la taille :
// le premier prolonge le titre, le second ouvre le texte. Deux blocs gris de
// corps voisin se seraient confondus.
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	lead?: string;
}

const { eyebrow, title, subtitle, lead } = Astro.props;
---

<header class="container head">
	{eyebrow && <p class="eyebrow head__eyebrow">{eyebrow}</p>}
	<h1 class="head__title">{title}</h1>
	{subtitle && <p class="head__subtitle">{subtitle}</p>}
	{lead && <p class="head__lead">{lead}</p>}
</header>

<style>
	.head {
		margin-bottom: clamp(36px, 5vw, 56px);
	}

	.head__eyebrow {
		margin: 0 0 20px;
	}

	.head__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: clamp(30px, 4.4vw, 50px);
		line-height: 1.03;
		letter-spacing: -0.02em;
		margin: 0;
		max-width: 18ch;
		text-wrap: balance;
	}

	.head__subtitle {
		font-family: var(--font-title);
		font-weight: 400;
		font-size: clamp(19px, 2.6vw, 25px);
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--muted-strong);
		max-width: 38ch;
		margin: 16px 0 0;
		text-wrap: balance;
	}

	.head__lead {
		font-size: clamp(17px, 2.2vw, 20px);
		line-height: 1.55;
		color: var(--text);
		max-width: 620px;
		margin: 22px 0 0;
	}
</style>
