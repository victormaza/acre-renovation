---
import SectionHead from './SectionHead.astro';

interface Props {
	id?: string;
	eyebrow: string;
	title: string;
	linkLabel?: string;
	linkHref?: string;
	linkItemLabel: string;
	items: { category: string; title: string; excerpt: string; href: string }[];
}

const { id, eyebrow, title, linkLabel, linkHref, linkItemLabel, items } = Astro.props;
---

<section class="container section" id={id}>
	<SectionHead eyebrow={eyebrow} title={title} linkLabel={linkLabel} linkHref={linkHref} />

	<ul class="grid">
		{
			items.map((item) => (
				<li>
					<a class="guide" href={item.href}>
						<p class="guide__category">{item.category}</p>
						<h3 class="guide__title">{item.title}</h3>
						<p class="guide__excerpt">{item.excerpt}</p>
						<span class="guide__link">
							{linkItemLabel} <span class="arrow">→</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.guide {
		display: block;
		border-top: 2px solid var(--ink);
		padding-top: 22px;
	}

	.guide__category {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-soft);
		margin: 0 0 14px;
	}

	.guide__title {
		font-family: var(--font-title);
		font-weight: 600;
		font-size: 22px;
		line-height: 1.18;
		margin: 0 0 12px;
		text-wrap: pretty;
	}

	.guide__excerpt {
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--muted);
		margin: 0 0 16px;
	}

	.guide__link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 14.5px;
		font-weight: 600;
	}
</style>
