---
interface Link {
	label: string;
	href: string;
}

interface Props {
	baseline: string;
	mentions: string;
	columns: { title: string; links: Link[] }[];
	zones: { title: string; links: Link[] };
	copyright: string;
	legal: Link[];
}

const { baseline, mentions, columns, zones, copyright, legal } = Astro.props;
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__grid">
			<div>
				<p class="logo">ACRE<span class="logo__dot">.</span></p>
				<p class="footer__baseline">{baseline}</p>
				<p class="footer__mentions">{mentions}</p>
			</div>

			{
				columns.map((column) => (
					<div>
						<p class="footer__title">{column.title}</p>
						<ul class="footer__links">
							{column.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}

			<div>
				<p class="footer__title">{zones.title}</p>
				<ul class="footer__zones">
					{
						zones.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<p class="footer__copyright">{copyright}</p>
			<ul class="footer__legal">
				{
					legal.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>

<style>
	.footer {
		margin-top: 96px;
		border-top: 1px solid var(--line);
		background: var(--bg);
	}

	.footer__inner {
		padding-top: 64px;
		padding-bottom: 40px;
	}

	.footer__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 48px;
		padding-bottom: 52px;
		border-bottom: 1px solid var(--line);
	}

	.logo {
		font-family: var(--font-title);
		font-weight: 700;
		font-size: 26px;
		letter-spacing: 0.12em;
		margin: 0 0 18px;
	}

	.logo__dot {
		color: var(--accent);
	}

	.footer__baseline {
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0 0 20px;
		max-width: 300px;
	}

	.footer__mentions {
		font-size: 13.5px;
		color: var(--muted-soft);
		margin: 0;
	}

	.footer__title {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted-soft);
		margin: 0 0 18px;
	}

	.footer__links,
	.footer__zones,
	.footer__legal {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer__links {
		display: flex;
		flex-direction: column;
		gap: 11px;
		font-size: 15px;
		color: var(--text);
	}

	.footer__zones {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 18px;
		font-size: 14.5px;
		color: var(--text);
		max-width: 320px;
	}

	.footer__bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
		padding-top: 26px;
		font-size: 13.5px;
		color: var(--muted-soft);
	}

	.footer__copyright {
		margin: 0;
	}

	.footer__legal {
		display: flex;
		gap: 22px;
	}
</style>
