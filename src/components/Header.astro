---
import type { NavItem, NavLink } from '../types';

interface Props {
	nav: NavItem[];
	cta: NavLink;
	phone: NavLink;
}

const { nav, cta, phone } = Astro.props;
---

<header class="header">
	<div class="container header__inner">
		<a class="logo" href="/">
			<img src="/logo-acre.webp" alt="ACRE rénovation" width="560" height="272" />
		</a>

		<button
			class="burger"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Ouvrir le menu"
		>
			<span></span><span></span><span></span>
		</button>

		<nav class="nav" id="site-nav">
			<ul class="nav__list">
				{
					nav.map((item) =>
						item.children ? (
							<li class="nav__item nav__item--menu">
								<button class="nav__toggle" type="button" aria-expanded="false">
									{item.label}
									<span class="nav__caret" aria-hidden="true">▼</span>
								</button>
								<div class="nav__menu">
									<div class="nav__menu-inner">
										{item.children.map((child) => (
											<a class="nav__menu-link" href={child.href}>
												{child.label}
											</a>
										))}
									</div>
								</div>
							</li>
						) : (
							<li class="nav__item">
								<a class="nav__link" href={item.href}>
									{item.label}
								</a>
							</li>
						)
					)
				}
			</ul>
		</nav>

		<div class="header__actions">
			<a class="header__phone" href={phone.href}>
				<svg
					class="header__phone-icon"
					viewBox="0 0 24 24"
					width="18"
					height="18"
					aria-hidden="true"
				>
					<path
						fill="currentColor"
						d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"
					></path>
				</svg>
				<span class="header__phone-label">{phone.label}</span>
			</a>

			<a class="btn btn--dark header__cta" href={cta.href}>
				<span class="btn-dot"></span>{cta.label}
			</a>
		</div>
	</div>
</header>

<script>
	const DESKTOP = window.matchMedia('(min-width: 861px)');

	// Menu burger
	const burger = document.querySelector<HTMLButtonElement>('.burger');
	const nav = document.getElementById('site-nav');

	burger?.addEventListener('click', () => {
		const open = burger.getAttribute('aria-expanded') === 'true';
		burger.setAttribute('aria-expanded', String(!open));
		burger.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
		nav?.classList.toggle('nav--open', !open);
	});

	// Sous-menus : survol au desktop, clic partout, fermeture au focusout et à Échap
	document.querySelectorAll<HTMLElement>('.nav__item--menu').forEach((item) => {
		const toggle = item.querySelector<HTMLButtonElement>('.nav__toggle');
		if (!toggle) return;

		const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));

		toggle.addEventListener('click', () =>
			setOpen(toggle.getAttribute('aria-expanded') !== 'true')
		);
		item.addEventListener('mouseenter', () => DESKTOP.matches && setOpen(true));
		item.addEventListener('mouseleave', () => DESKTOP.matches && setOpen(false));
		item.addEventListener('focusout', (event) => {
			if (!item.contains(event.relatedTarget as Node)) setOpen(false);
		});
		item.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				setOpen(false);
				toggle.focus();
			}
		});
	});
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgb(251 250 247 / 0.92);
		backdrop-filter: saturate(1.2) blur(8px);
		border-bottom: 1px solid var(--line);
	}

	.header__inner {
		height: 76px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
	}

	.logo {
		display: flex;
		align-items: center;
		flex: none;
	}

	/* Le logo est fourni en bitmap : on le contraint par la hauteur, la largeur
	   suit le ratio intrinsèque de l'image. */
	.logo img {
		height: 48px;
		width: auto;
	}

	/* ---- Navigation ---- */

	.nav__list {
		display: flex;
		align-items: center;
		gap: 30px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 15px;
		font-weight: 500;
	}

	.nav__item {
		position: relative;
	}

	.nav__link,
	.nav__toggle {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 6px 0;
		font: inherit;
		color: var(--text-nav);
		background: none;
		border: none;
		cursor: pointer;
	}

	.nav__link:hover,
	.nav__toggle:hover {
		color: var(--accent-link-hover);
	}

	.nav__caret {
		display: inline-block;
		font-size: 10px;
		color: var(--muted-soft);
		transition: transform 0.18s ease;
	}

	.nav__toggle[aria-expanded='true'] .nav__caret {
		transform: rotate(180deg);
	}

	.nav__menu {
		display: none;
		position: absolute;
		top: 100%;
		left: -18px;
		padding-top: 12px;
	}

	.nav__toggle[aria-expanded='true'] + .nav__menu {
		display: block;
	}

	.nav__menu-inner {
		min-width: 288px;
		padding: 8px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-dropdown);
		overflow: hidden;
	}

	.nav__menu-link {
		display: block;
		padding: 12px 16px;
		border-radius: var(--radius-sm);
		font-weight: 500;
	}

	.nav__menu-link:hover {
		background: #f5f1e9;
		color: var(--ink);
	}

	/* ---- Téléphone et bouton devis ---- */

	.header__actions {
		display: flex;
		align-items: center;
		gap: 24px;
		flex: none;
	}

	/* Le devis reste l'action principale : le téléphone est un lien, pas un
	   second bouton plein qui lui disputerait le regard. */
	.header__phone {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-size: 15px;
		font-weight: 600;
		color: var(--ink);
		white-space: nowrap;
	}

	.header__phone:hover {
		color: var(--accent-link-hover);
	}

	.header__phone-icon {
		flex: none;
		color: var(--accent);
	}

	/* Là où la barre manque de place — desktop étroit, où le menu occupe
	   encore la ligne, et petits téléphones — le numéro s'efface derrière son
	   icône. Il reste dans le lien, lu par les lecteurs d'écran. Le numéro tient
	   dès ~1000 px sur desktop et ~350 px sur mobile ; en dessous, il pousse le
	   burger hors de l'écran. Le seuil desktop garde une marge : le menu
	   s'allonge à chaque expertise publiée. */
	@media (min-width: 861px) and (max-width: 959px), (max-width: 359px) {
		.header__phone {
			justify-content: center;
			min-width: 44px;
		}

		.header__phone-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	.header__cta {
		padding: 12px 22px;
		font-size: 15px;
	}

	/* ---- Burger ---- */

	.burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		margin-right: -10px;
		padding: 0 10px;
		flex: none;
		background: none;
		border: none;
		cursor: pointer;
		order: 3;
	}

	.burger span {
		display: block;
		height: 1.5px;
		background: var(--ink);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.burger[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}

	.burger[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}

	.burger[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	/* ---- Mobile ---- */

	@media (max-width: 860px) {
		.burger {
			display: flex;
		}

		.header__cta {
			display: none;
		}

		/* Sans le bouton devis, reporté dans la barre collante, le téléphone
		   rejoint le burger au lieu de flotter au milieu de la barre. */
		.header__inner {
			gap: 16px;
		}

		.header__actions {
			order: 2;
			margin-left: auto;
		}

		.nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			padding: 8px var(--gutter) 24px;
			background: var(--bg);
			border-bottom: 1px solid var(--line);
			max-height: calc(100dvh - 76px);
			overflow-y: auto;
		}

		.nav--open {
			display: block;
		}

		.nav__list {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			font-size: 17px;
		}

		.nav__item {
			border-bottom: 1px solid var(--line);
		}

		.nav__link,
		.nav__toggle {
			width: 100%;
			justify-content: space-between;
			padding: 16px 0;
		}

		.nav__menu {
			position: static;
			padding-top: 0;
		}

		.nav__menu-inner {
			min-width: 0;
			padding: 0 0 12px;
			border: none;
			border-radius: 0;
			box-shadow: none;
			background: none;
		}

		.nav__menu-link {
			padding: 12px 0 12px 16px;
			font-size: 15px;
			color: var(--text);
		}
	}
</style>
