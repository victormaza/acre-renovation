---
// Section « Réalisations récentes » : en-tête de section + grille de chantiers.
// La grille elle-même vit dans RealisationGrid, partagée avec /realisations.
import RealisationGrid from './RealisationGrid.astro';
import SectionHead from './SectionHead.astro';
import type { RealisationCard } from '../types';

interface Props {
	id?: string;
	eyebrow: string;
	title: string;
	linkLabel?: string;
	linkHref?: string;
	items: RealisationCard[];
}

const { id, eyebrow, title, linkLabel, linkHref, items } = Astro.props;
---

<section class="container section" id={id}>
	<SectionHead eyebrow={eyebrow} title={title} linkLabel={linkLabel} linkHref={linkHref} />
	<RealisationGrid items={items} />
</section>
