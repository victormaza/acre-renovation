---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { nav, devisCta, footer } from '../data/settings';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	/**
	 * Retire navigation, pied de page et barre CTA. Réservé au tunnel de devis :
	 * tout lien latéral y est une occasion d'abandonner en cours de route.
	 */
	bare?: boolean;
}

const { title, description, noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://acre-renovation.fr');
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Acre Rénovation" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class={bare ? 'is-bare' : undefined}>
		{bare ? <slot /> : (
			<>
				<Header nav={nav} cta={devisCta} />
				<main>
					<slot />
				</main>
				<Footer {...footer} />
				<StickyCta {...devisCta} />
			</>
		)}
	</body>
</html>

<style>
	/* Laisse la place à la barre CTA collante en bas d'écran. */
	@media (max-width: 860px) {
		body:not(.is-bare) {
			padding-bottom: 84px;
		}
	}

	.is-bare {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
</style>
