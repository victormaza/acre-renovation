---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { getNav, getFooter, devisCta, phoneCta } from '../navigation';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	/**
	 * Retire navigation, pied de page et barre CTA. Réservé au tunnel de devis :
	 * tout lien latéral y est une occasion d'abandonner en cours de route.
	 */
	bare?: boolean;
}

const { title, description, noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://acre-renovation.fr');

// Menu et pied de page dépendent des expertises publiées : le tunnel de devis
// n'affiche ni l'un ni l'autre, inutile d'interroger Prismic pour lui.
const [nav, footer] = bare ? [[], null] : await Promise.all([getNav(), getFooter()]);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Acre Rénovation" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta name="generator" content={Astro.generator} />
		<!-- Google tag (gtag.js) — `is:inline` : Astro ne doit ni regrouper ni déplacer ces scripts. -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-510PHSG6RD"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-510PHSG6RD');

			// Clics sur les numéros de téléphone, pour mesurer les appels dans
			// Analytics et Google Ads. Délégué au document : couvre tout lien
			// `tel:` du site, présent ou à venir.
			document.addEventListener('click', function (e) {
				var a = e.target.closest && e.target.closest('a[href^="tel:"]');
				if (a && typeof gtag === 'function') {
					gtag('event', 'clic_telephone', { link_url: a.href });
				}
			});
		</script>
	</head>
	<body class={bare ? 'is-bare' : undefined}>
		{bare || !footer ? <slot /> : (
			<>
				<Header nav={nav} cta={devisCta} phone={phoneCta} />
				<main>
					<slot />
				</main>
				<Footer {...footer} />
				<StickyCta {...devisCta} />
			</>
		)}
	</body>
</html>

<style>
	/* Laisse la place à la barre CTA collante en bas d'écran. */
	@media (max-width: 860px) {
		body:not(.is-bare) {
			padding-bottom: 84px;
		}
	}

	.is-bare {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
</style>
