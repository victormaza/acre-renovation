---
import { asText, asLink, isFilled } from '@prismicio/client';
import type {
	ContentRelationshipField,
	ImageFieldImage,
	KeyTextField,
	LinkField,
	NumberField,
	PrismicDocument,
	RichTextField,
} from '@prismicio/client';
import Realisations from '../../components/Realisations.astro';
import { resolvePicks } from '../../prismicio';
import type { SliceContext } from '../../types';

type RealisationDocument = PrismicDocument<
	{
		title: KeyTextField;
		city: KeyTextField;
		meta: KeyTextField;
		expertise: ContentRelationshipField;
		image: ImageFieldImage;
		gallery: { image: ImageFieldImage; caption: KeyTextField }[];
	},
	'realisation'
>;

export interface RealisationsSlice {
	slice_type: 'realisations';
	primary: {
		eyebrow: KeyTextField;
		title: RichTextField;
		link: LinkField & { text?: string | null };
		count: NumberField;
		items: { realisation: LinkField }[];
	};
}

interface Props {
	slice: RealisationsSlice;
	context?: SliceContext;
}

const { primary } = Astro.props.slice;
const context = Astro.props.context;

// Le lien « voir tout » disparaît tant qu'il n'est pas renseigné, plutôt que
// de pointer vers une page qui n'existe pas encore.
const hasLink = isFilled.link(primary.link);

// Sur une page expertise, le repli automatique ne pioche que dans les
// chantiers rattachés à cette expertise — sinon la section « Réalisations
// liées » afficherait des chantiers d'un autre métier. La sélection manuelle,
// elle, reste souveraine : c'est un choix explicite du client.
const expertiseId = context?.expertiseId;

const isLinkedToExpertise = (document: RealisationDocument) => {
	const link = document.data.expertise;
	return !!link && isFilled.contentRelationship(link) && link.id === expertiseId;
};

const documents = await resolvePicks<RealisationDocument>(
	'realisation',
	(primary.items ?? []).map((item) => item.realisation),
	{
		limit: primary.count ?? 4,
		match: expertiseId ? isLinkedToExpertise : undefined,
	},
);

const items = documents.map((document) => ({
	city: document.data.city ?? '',
	title: document.data.title ?? '',
	meta: document.data.meta ?? '',
	image: { field: document.data.image, sizes: '(min-width: 900px) 300px, 50vw' },
	// La couverture reste seule sur la carte ; les autres photos ne servent
	// qu'à la visionneuse.
	gallery: (document.data.gallery ?? []).map((photo) => ({
		field: photo.image,
		caption: photo.caption ?? undefined,
	})),
}));
---

{
	items.length > 0 && (
		<Realisations
			id="realisations"
			eyebrow={primary.eyebrow ?? ''}
			title={asText(primary.title)}
			linkLabel={hasLink ? (primary.link.text ?? 'Tout voir') : undefined}
			linkHref={hasLink ? (asLink(primary.link) ?? undefined) : undefined}
			items={items}
		/>
	)
}
